    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GuardAI.Core\GuardAI.Core.csproj" />
    <ProjectReference Include="..\..\src\GuardAI.Checks\GuardAI.Checks.csproj" />
    <ProjectReference Include="..\..\src\GuardAI.Init\GuardAI.Init.csproj" />
    <ProjectReference Include="..\..\src\GuardAI.Cli\GuardAI.Cli.csproj" />
  </ItemGroup>

